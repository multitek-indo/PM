# TEMPLATE ONLY. Do not copy live secrets here.
# Production installer pins image IDs; these examples are not an install script.
PM_PYTHON_IMAGE=python:3.12-slim-bookworm
PM_POSTGRES_IMAGE=postgres:16
PM_SECRET_KEY=CHANGE_ME_WITH_NEW_RANDOM_VALUE
PM_DB_PASSWORD=CHANGE_ME_WITH_NEW_RANDOM_VALUE
PM_POSTGRES_PASSWORD=CHANGE_ME_WITH_NEW_RANDOM_VALUE
PM_ALLOWED_HOSTS=127.0.0.1,localhost
PM_PUBLIC_BASE_URL=
PM_CSRF_ORIGINS=
PM_HTTPS=0

# Runtime: versioned dependency volume, never a database volume.
PM_PACKAGES_VOLUME=multitek-pm_packages
